# Copy to .env for local runs. On Railway, set these as service variables.
APP_ENV=development                 # 'production' on Railway (forces secure cookies)
SECRET_KEY=change-me                # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"

# Supabase project that holds the check-in app's students and check_ins tables.
# Use the SESSION POOLER connection string (port 5432) from Supabase > Connect.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # the public anon key; used only to call Supabase Auth

INSTITUTION_SLUG=sacred-heart

# ---- Email (phase 2). outbox = nothing sent; test = everything to EMAIL_TEST_RECIPIENT; live = parents
EMAIL_MODE=test
EMAIL_TEST_RECIPIENT=trichtoure@gmail.com
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=billing@yourdomain.com   # must be a verified sender in SendGrid
EMAIL_FROM_NAME=MealMode
SUPPORT_EMAIL=

# ---- Parent links
PORTAL_SECRET=change-me-32-plus-chars   # python -c "import secrets;print(secrets.token_urlsafe(48))"
PUBLIC_BASE_URL=                        # blank = http://127.0.0.1:5000 locally; your Railway URL in production

# ---- Stripe (phase 3). Leave both blank to keep online payments off.
STRIPE_SECRET_KEY=                      # sk_test_... (Developers > API keys)
STRIPE_WEBHOOK_SECRET=                  # whsec_... (Developers > Webhooks > your endpoint)
