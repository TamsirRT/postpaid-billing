# Copy to .env for local runs. On Railway, set these as service variables.
APP_ENV=development                 # 'production' on Railway (forces secure cookies)
SECRET_KEY=change-me                # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"

# Supabase project that holds the check-in app's students and check_ins tables.
# Use the SESSION POOLER connection string (port 5432) from Supabase > Connect.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # the public anon key; used only to call Supabase Auth

INSTITUTION_SLUG=sacred-heart
